APP_ENV=development
DEBUG=false

MAX_UPLOAD_SIZE_MB=50
MIN_AUDIO_DURATION_SECONDS=0.5
MAX_AUDIO_DURATION_SECONDS=600

UPLOAD_DIR=data/uploads
PROCESSED_DIR=data/processed
MODEL_DIR=models

ASR_MODEL_NAME=tiny
# Leave blank to let Whisper detect the language.
ASR_LANGUAGE=
EMOTION_MODEL_NAME=ehcalabres/wav2vec2-lg-xlsr-en-speech-emotion-recognition
AI_DEVICE=auto
ENABLE_AI_MOCKS=false

# Optional for private or gated Hugging Face models. Never commit a real token.
HF_TOKEN=
